{
  "name": "vision-ml-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Teach a small convolutional network to read your pictures, in your browser. Twenty practise shapes are built in.",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node tools/serve.js 4330",
    "serve": "node tools/serve.js 4330",
    "cascade": "node tools/build-cascade.mjs",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/static.test.js",
    "test:e2e": "npm run build && node --test test/e2e.test.js",
    "test:live": "node tools/verify-live-consent.mjs",
    "test:all": "npm run build && node --test test/*.test.js",
    "deploy": "bash tools/deploy.sh"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
